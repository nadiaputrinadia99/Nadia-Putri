# ==============================================================================
# ENVIRONMENT VARIABLES - PERSONAL PORTFOLIO WEBSITE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Untuk Sinkronisasi Database & Storage)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Anon / Public Key Supabase (safe for browser client)
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Opsional - khusus backend server)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. Vercel Cron Secret (Validasi Endpoint Keep-Alive Supabase)
# Dapatkan / tentukan nilai acak aman untuk header Authorization Cron
# ------------------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------------------
# 3. AI Studio & Deployment Runtime (Diisi otomatis oleh platform)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=
